# Leave MOCK_MODE=true to run the whole app with zero paid API keys.
MOCK_MODE=true

# Telecom / CNAM (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# B2B enrichment (any phone-to-person provider; see providers.py)
B2B_API_KEY=
B2B_BASE_URL=https://api.blitz-api.ai/v2/enrichment/phone-to-person

# Transient cache lifetime in seconds (24h default)
CACHE_TTL_SECONDS=86400

# Per-IP rate limit for /lookup
RATE_LIMIT_PER_MINUTE=20

# Comma-separated shared secrets the iOS app sends as X-DeskCall-Key.
# Empty = open endpoint (fine for a private sideloaded build).
CLIENT_KEYS=
